.search-header { display: flex; align-items: center; gap: 16rpx; padding: 16rpx 24rpx; background: #fff; }
.search-input { flex: 1; background: #F7F5F2; border-radius: 40rpx; padding: 16rpx 24rpx; font-size: 28rpx; }
.search-btn { background: #3C8D6E; color: #fff; border-radius: 40rpx; padding: 16rpx 32rpx; font-size: 28rpx; font-weight: 500; }
.tab-bar { display: flex; border-bottom: 2rpx solid #EDEBE8; background: #fff; }
.tab { flex: 1; text-align: center; padding: 20rpx 0; font-size: 28rpx; color: #7F8C8D; }
.tab.active { color: #3C8D6E; font-weight: 600; border-bottom: 4rpx solid #3C8D6E; }
.result-list { padding: 16rpx 24rpx; }
.empty-tip { text-align: center; color: #7F8C8D; padding: 80rpx 0; font-size: 28rpx; }
