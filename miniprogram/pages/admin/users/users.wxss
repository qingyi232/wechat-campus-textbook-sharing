.container { padding: 20rpx; background: #f5f5f5; min-height: 100vh; }
.search-bar { display: flex; align-items: center; background: #fff; border-radius: 16rpx; padding: 16rpx 20rpx; margin-bottom: 20rpx; }
.search-input { flex: 1; font-size: 28rpx; height: 60rpx; }
.search-btn { background: #3C8D6E; color: #fff; font-size: 26rpx; padding: 10rpx 30rpx; border-radius: 30rpx; }
.filter-bar { display: flex; margin-bottom: 20rpx; gap: 16rpx; }
.filter-item { font-size: 26rpx; padding: 10rpx 28rpx; background: #fff; border-radius: 30rpx; color: #666; }
.filter-item.active { background: #3C8D6E; color: #fff; }
.user-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; }
.user-header { display: flex; align-items: center; }
.user-avatar { width: 80rpx; height: 80rpx; border-radius: 50%; background: #3C8D6E; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 32rpx; font-weight: bold; }
.user-info { flex: 1; margin-left: 20rpx; }
.user-name { font-size: 30rpx; font-weight: bold; color: #333; display: block; }
.user-role { font-size: 22rpx; padding: 4rpx 14rpx; border-radius: 16rpx; margin-top: 6rpx; display: inline-block; }
.role-admin { background: #fff3e0; color: #e65100; }
.role-teacher { background: #e3f2fd; color: #1565c0; }
.role-student { background: #e8f5e9; color: #2e7d32; }
.user-status { font-size: 24rpx; padding: 6rpx 16rpx; border-radius: 16rpx; }
.status-active { background: #e8f5e9; color: #2e7d32; }
.status-disabled { background: #ffebee; color: #c62828; }
.user-detail { margin-top: 16rpx; padding-top: 16rpx; border-top: 1rpx solid #f0f0f0; }
.detail-item { font-size: 24rpx; color: #888; margin-right: 24rpx; }
.user-actions { display: flex; margin-top: 16rpx; gap: 16rpx; justify-content: flex-end; }
.action-btn { font-size: 24rpx; padding: 8rpx 24rpx; border-radius: 20rpx; }
.btn-warn { background: #fff3e0; color: #e65100; }
.btn-success { background: #e8f5e9; color: #2e7d32; }
.btn-info { background: #e3f2fd; color: #1565c0; }
.btn-danger { background: #ffebee; color: #c62828; }
.empty, .loading, .load-more { text-align: center; padding: 40rpx; color: #999; font-size: 28rpx; }
.load-more { color: #3C8D6E; }
