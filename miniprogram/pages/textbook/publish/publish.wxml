<view class="container">
  <view class="card">
    <view class="section-title">发布二手教材</view>
    <view class="form-item"><text class="label">教材名称</text><input placeholder="输入教材名称" value="{{form.title}}" bindinput="onInput" data-field="title" /></view>
    <view class="form-item"><text class="label">作者</text><input placeholder="教材作者" value="{{form.author}}" bindinput="onInput" data-field="author" /></view>
    <view class="form-item"><text class="label">出版社</text><input placeholder="出版社" value="{{form.publisher}}" bindinput="onInput" data-field="publisher" /></view>
    <view class="form-item"><text class="label">原价(元)</text><input type="digit" placeholder="原价" value="{{form.originalPrice}}" bindinput="onInput" data-field="originalPrice" /></view>
    <view class="form-item"><text class="label">售价(元)</text><input type="digit" placeholder="售价" value="{{form.price}}" bindinput="onInput" data-field="price" /></view>
    <view class="form-item"><text class="label">成色</text>
      <picker range="{{conditions}}" range-key="label" bindchange="onConditionChange">
        <text>{{form.bookCondition ? conditionMap[form.bookCondition] : '选择成色'}}</text>
      </picker>
    </view>
    <view class="form-item"><text class="label">课程</text>
      <picker range="{{courses}}" range-key="courseName" bindchange="onCourseChange">
        <text>{{selectedCourse || '选择关联课程(可选)'}}</text>
      </picker>
    </view>
    <view class="form-item"><text class="label">描述</text>
      <textarea placeholder="描述教材状况..." value="{{form.description}}" bindinput="onInput" data-field="description" auto-height maxlength="500" />
    </view>
    <view class="form-item"><text class="label">联系方式</text><input placeholder="微信号或手机号" value="{{form.contactInfo}}" bindinput="onInput" data-field="contactInfo" /></view>
    <view class="img-upload">
      <text class="label">教材照片</text>
      <view class="img-list">
        <image wx:for="{{images}}" wx:key="*this" src="{{item}}" class="up-img" mode="aspectFill" bindtap="previewImg" data-url="{{item}}" />
        <view class="add-img" bindtap="chooseImage" wx:if="{{images.length < 6}}">
          <text>+</text>
        </view>
      </view>
    </view>
    <button class="btn-primary" style="margin-top:30rpx" bindtap="handlePublish" loading="{{loading}}">发布教材</button>
  </view>
</view>
