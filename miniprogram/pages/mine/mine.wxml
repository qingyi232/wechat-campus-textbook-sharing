<view class="container">
  <view class="profile-card">
    <view class="avatar">{{userInfo.realName ? userInfo.realName[0] : '?'}}</view>
    <view class="profile-info">
      <text class="profile-name">{{userInfo.realName || '未登录'}}</text>
      <text class="profile-role">{{roleMap[userInfo.role] || ''}} · {{userInfo.majorName || ''}} {{userInfo.grade ? '· ' + userInfo.grade + '级' : ''}}</text>
    </view>
  </view>

  <view class="menu-card" wx:if="{{userInfo.role === 'ADMIN'}}">
    <view class="menu-section-title">管理功能</view>
    <view class="menu-item" bindtap="goTo" data-url="/pages/admin/users/users">
      <image class="menu-icon" src="/images/icon-teacher.png" mode="aspectFit" />
      <text class="menu-text">用户管理</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goTo" data-url="/pages/admin/audit/audit">
      <image class="menu-icon" src="/images/icon-star.png" mode="aspectFit" />
      <text class="menu-text">内容审核</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goTo" data-url="/pages/admin/stats/stats">
      <image class="menu-icon" src="/images/icon-search.png" mode="aspectFit" />
      <text class="menu-text">数据统计</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <view class="menu-card" wx:if="{{userInfo.role === 'TEACHER'}}">
    <view class="menu-section-title">教师功能</view>
    <view class="menu-item" bindtap="goTo" data-url="/pages/teacher/teacher">
      <image class="menu-icon" src="/images/icon-teacher.png" mode="aspectFit" />
      <text class="menu-text">课程推荐管理</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <view class="menu-card">
    <view class="menu-section-title">我的内容</view>
    <view class="menu-item" bindtap="goTo" data-url="/pages/mine/textbooks/textbooks">
      <image class="menu-icon" src="/images/icon-publish.png" mode="aspectFit" />
      <text class="menu-text">我发布的教材</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goTo" data-url="/pages/mine/notes/notes">
      <image class="menu-icon" src="/images/icon-upload.png" mode="aspectFit" />
      <text class="menu-text">我上传的笔记</text>
      <text class="menu-arrow">></text>
    </view>
    <view class="menu-item" bindtap="goTo" data-url="/pages/mine/favorites/favorites">
      <image class="menu-icon" src="/images/icon-star.png" mode="aspectFit" />
      <text class="menu-text">我的收藏</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <view class="menu-card">
    <view class="menu-item" bindtap="goTo" data-url="/pages/notice/notice">
      <image class="menu-icon" src="/images/icon-bell.png" mode="aspectFit" />
      <text class="menu-text">消息通知</text>
      <text class="menu-arrow">></text>
    </view>
  </view>

  <button class="logout-btn" bindtap="handleLogout">退出登录</button>
</view>
