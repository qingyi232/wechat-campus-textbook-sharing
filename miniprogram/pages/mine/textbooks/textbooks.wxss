.page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.page-count { font-size: 26rpx; color: #7F8C8D; }

.tb-card { background: #fff; border-radius: 16rpx; padding: 20rpx; margin-bottom: 20rpx; display: flex; box-shadow: 0 2rpx 12rpx rgba(45,52,54,0.05); }
.tb-cover { width: 160rpx; height: 200rpx; border-radius: 12rpx; flex-shrink: 0; background: #F7F5F2; }
.tb-body { flex: 1; margin-left: 20rpx; display: flex; flex-direction: column; justify-content: space-between; overflow: hidden; }
.tb-top { display: flex; justify-content: space-between; align-items: flex-start; }
.tb-name { font-size: 30rpx; font-weight: 600; color: #2D3436; flex: 1; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; margin-right: 12rpx; }
.tb-author { font-size: 24rpx; color: #7F8C8D; margin-top: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }

.status-badge { font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 20rpx; font-weight: 500; flex-shrink: 0; }
.badge-green { background: #EBF5F0; color: #3C8D6E; }
.badge-gray { background: #F2F3F5; color: #7F8C8D; }
.badge-orange { background: #FFF3E0; color: #D4875C; }

.tb-bottom { display: flex; justify-content: space-between; align-items: center; margin-top: 12rpx; }
.tb-price { color: #CF5C3F; font-weight: 700; font-size: 36rpx; }
.tb-price::before { content: '¥'; font-size: 24rpx; }

.tb-ops { display: flex; gap: 16rpx; }
.op-btn { font-size: 24rpx; padding: 8rpx 20rpx; border-radius: 24rpx; font-weight: 500; }
.op-primary { background: #EBF5F0; color: #3C8D6E; }
.op-danger { background: #FBE9E7; color: #CF5C3F; }

.empty-state { text-align: center; padding: 120rpx 0; }
.empty-icon { width: 120rpx; height: 120rpx; opacity: 0.4; margin-bottom: 24rpx; }
.empty-text { display: block; font-size: 30rpx; color: #7F8C8D; margin-bottom: 12rpx; }
.empty-sub { display: block; font-size: 24rpx; color: #B0B8BD; }
