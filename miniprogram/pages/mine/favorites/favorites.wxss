.tab-bar { display: flex; background: #fff; padding: 0 24rpx; position: sticky; top: 0; z-index: 10; }
.tab { flex: 1; text-align: center; padding: 26rpx 0; font-size: 28rpx; color: #7F8C8D; border-bottom: 4rpx solid transparent; }
.tab.active { color: #3C8D6E; font-weight: 600; border-bottom-color: #3C8D6E; }

.fav-list { padding: 20rpx 24rpx; }
.fav-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 2rpx 12rpx rgba(45,52,54,0.05); }
.fav-body { flex: 1; overflow: hidden; }
.fav-title { font-size: 28rpx; font-weight: 600; color: #2D3436; display: block; margin-bottom: 8rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.fav-meta { font-size: 24rpx; color: #7F8C8D; }
.fav-price { color: #CF5C3F; font-weight: 700; font-size: 32rpx; flex-shrink: 0; margin-left: 16rpx; }
.fav-price::before { content: '¥'; font-size: 22rpx; }
.fav-free { color: #3C8D6E; font-weight: 600; font-size: 28rpx; flex-shrink: 0; margin-left: 16rpx; }

.empty-state { text-align: center; padding: 100rpx 0; }
.empty-icon { width: 100rpx; height: 100rpx; opacity: 0.4; margin-bottom: 20rpx; }
.empty-text { display: block; font-size: 28rpx; color: #7F8C8D; }
