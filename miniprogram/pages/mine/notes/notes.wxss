.page-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20rpx; }
.page-count { font-size: 26rpx; color: #7F8C8D; }

.note-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 20rpx; box-shadow: 0 2rpx 12rpx rgba(45,52,54,0.05); }
.note-top { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 10rpx; }
.note-title { font-size: 30rpx; font-weight: 600; color: #2D3436; flex: 1; margin-right: 12rpx; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
.note-course { font-size: 24rpx; color: #7F8C8D; display: block; margin-bottom: 12rpx; }

.status-badge { font-size: 20rpx; padding: 4rpx 14rpx; border-radius: 20rpx; font-weight: 500; flex-shrink: 0; }
.badge-green { background: #EBF5F0; color: #3C8D6E; }
.badge-orange { background: #FFF8ED; color: #C9A96E; }
.badge-red { background: #FBE9E7; color: #CF5C3F; }

.note-bottom { display: flex; justify-content: space-between; align-items: center; }
.note-stats { display: flex; gap: 16rpx; }
.stat-item { font-size: 22rpx; color: #999; }
.note-price { color: #CF5C3F; font-weight: 700; font-size: 30rpx; }
.note-free { color: #3C8D6E; font-weight: 600; font-size: 28rpx; }

.empty-state { text-align: center; padding: 120rpx 0; }
.empty-icon { width: 120rpx; height: 120rpx; opacity: 0.4; margin-bottom: 24rpx; }
.empty-text { display: block; font-size: 30rpx; color: #7F8C8D; margin-bottom: 12rpx; }
.empty-sub { display: block; font-size: 24rpx; color: #B0B8BD; }
