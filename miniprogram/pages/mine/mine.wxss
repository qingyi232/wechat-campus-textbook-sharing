.profile-card { background: linear-gradient(135deg, #3C8D6E, #2E7A5E); border-radius: 20rpx; padding: 40rpx; display: flex; align-items: center; gap: 24rpx; margin-bottom: 24rpx; }
.avatar { width: 100rpx; height: 100rpx; border-radius: 50%; background: rgba(255,255,255,0.2); display: flex; align-items: center; justify-content: center; font-size: 44rpx; color: #fff; font-weight: 600; }
.profile-name { font-size: 34rpx; font-weight: 600; color: #fff; display: block; margin-bottom: 6rpx; }
.profile-role { font-size: 24rpx; color: rgba(255,255,255,0.8); }
.menu-card { background: #fff; border-radius: 16rpx; margin-bottom: 20rpx; overflow: hidden; box-shadow: 0 2rpx 12rpx rgba(45,52,54,0.04); }
.menu-item { display: flex; align-items: center; padding: 28rpx 24rpx; border-bottom: 2rpx solid #F5F3F0; }
.menu-item:last-child { border-bottom: none; }
.menu-section-title { font-size: 22rpx; color: #7F8C8D; font-weight: 600; padding: 16rpx 24rpx 0; text-transform: uppercase; letter-spacing: 2rpx; }
.menu-icon { width: 40rpx; height: 40rpx; margin-right: 16rpx; flex-shrink: 0; }
.menu-text { flex: 1; font-size: 28rpx; color: #2D3436; }
.menu-arrow { font-size: 28rpx; color: #CCC; flex-shrink: 0; }
.logout-btn { margin-top: 40rpx; background: #fff; color: #CF5C3F; border-radius: 44rpx; font-size: 30rpx; box-shadow: 0 2rpx 12rpx rgba(45,52,54,0.04); }
