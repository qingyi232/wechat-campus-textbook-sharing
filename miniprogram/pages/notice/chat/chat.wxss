.chat-container { display: flex; flex-direction: column; height: 100vh; background: #F7F5F2; }
.chat-header { background: #fff; padding: 16rpx 24rpx; border-bottom: 2rpx solid #F0EDE8; }
.chat-about { font-size: 24rpx; color: #3C8D6E; }
.chat-body { flex: 1; padding: 24rpx; overflow-y: auto; }
.chat-msg { margin-bottom: 24rpx; }
.chat-msg.mine { display: flex; flex-direction: column; align-items: flex-end; }
.chat-msg.other { display: flex; flex-direction: column; align-items: flex-start; }
.msg-name { font-size: 22rpx; color: #7F8C8D; margin-bottom: 6rpx; }
.msg-bubble { max-width: 70%; padding: 18rpx 24rpx; border-radius: 16rpx; font-size: 28rpx; line-height: 1.5; word-break: break-all; }
.bubble-mine { background: #3C8D6E; color: #fff; border-bottom-right-radius: 4rpx; }
.bubble-other { background: #fff; color: #2D3436; border-bottom-left-radius: 4rpx; box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04); }
.msg-time { font-size: 20rpx; color: #bbb; margin-top: 6rpx; }
.empty-tip { text-align: center; color: #bbb; font-size: 26rpx; margin-top: 100rpx; }
.chat-input-bar { display: flex; align-items: center; padding: 16rpx 24rpx; background: #fff; border-top: 2rpx solid #F0EDE8; padding-bottom: calc(16rpx + env(safe-area-inset-bottom)); }
.chat-input { flex: 1; background: #F7F5F2; border-radius: 36rpx; padding: 16rpx 24rpx; font-size: 28rpx; }
.send-btn { background: linear-gradient(135deg, #3C8D6E, #2E7A5E); color: #fff; border-radius: 36rpx; padding: 16rpx 32rpx; font-size: 28rpx; font-weight: 500; margin-left: 16rpx; }
