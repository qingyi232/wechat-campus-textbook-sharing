.filter-bar { display: flex; gap: 12rpx; padding: 16rpx 24rpx; background: #fff; flex-wrap: wrap; }
.filter-btn { padding: 10rpx 24rpx; border-radius: 30rpx; font-size: 24rpx; background: #F7F5F2; color: #7F8C8D; }
.filter-btn.active { background: #3C8D6E; color: #fff; }
.note-list { padding: 16rpx 24rpx; }
.note-item { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; box-shadow: 0 2rpx 8rpx rgba(45,52,54,0.03); }
.note-item-title { font-size: 30rpx; font-weight: 500; display: block; margin-bottom: 8rpx; }
.note-item-meta { color: #7F8C8D; font-size: 24rpx; margin-bottom: 8rpx; }
.note-item-bottom { display: flex; justify-content: space-between; align-items: center; }
.note-item-stats { color: #7F8C8D; font-size: 22rpx; }
.note-free-tag { color: #3C8D6E; font-weight: 600; font-size: 26rpx; }
.fab-btn { position: fixed; right: 40rpx; bottom: 140rpx; width: 100rpx; height: 100rpx; background: linear-gradient(135deg, #3C8D6E, #2E7A5E); border-radius: 50%; display: flex; align-items: center; justify-content: center; box-shadow: 0 8rpx 24rpx rgba(60,141,110,0.35); }
.fab-icon { width: 44rpx; height: 44rpx; }
