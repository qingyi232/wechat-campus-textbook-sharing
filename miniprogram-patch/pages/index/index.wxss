.welcome-card { background: linear-gradient(135deg, #3C8D6E, #2E7A5E); border-radius: 20rpx; padding: 36rpx; color: #fff; display: flex; justify-content: space-between; align-items: center; margin-bottom: 24rpx; }
.welcome-hello { font-size: 36rpx; font-weight: 600; display: block; margin-bottom: 8rpx; }
.welcome-role { font-size: 24rpx; opacity: 0.85; }
.welcome-img { width: 100rpx; height: 100rpx; }
.banner-swiper { height: 240rpx; border-radius: 16rpx; overflow: hidden; margin-bottom: 24rpx; }
.banner-item { height: 240rpx; border-radius: 16rpx; display: flex; align-items: center; padding: 0 40rpx; }
.banner-1 { background: linear-gradient(135deg, #3C8D6E, #2E7A5E); }
.banner-2 { background: linear-gradient(135deg, #C9A96E, #B8944E); }
.banner-3 { background: linear-gradient(135deg, #5B8FB9, #4A7A9E); }
.banner-content { color: #fff; }
.banner-title { font-size: 36rpx; font-weight: 700; display: block; margin-bottom: 10rpx; }
.banner-desc { font-size: 26rpx; opacity: 0.9; }
.search-bar { background: #fff; border-radius: 40rpx; padding: 20rpx 30rpx; display: flex; align-items: center; gap: 16rpx; margin-bottom: 30rpx; box-shadow: 0 2rpx 12rpx rgba(45,52,54,0.04); }
.search-svg { width: 36rpx; height: 36rpx; flex-shrink: 0; }
.search-placeholder { color: #bbb; font-size: 28rpx; }
.nav-grid { display: flex; justify-content: space-between; }
.nav-item { flex: 1; text-align: center; }
.nav-icon { width: 88rpx; height: 88rpx; border-radius: 20rpx; display: flex; align-items: center; justify-content: center; margin: 0 auto 10rpx; }
.nav-item text { font-size: 24rpx; color: #555; }
.section { margin-top: 30rpx; }
.more-link { font-size: 24rpx; color: #3C8D6E; font-weight: 500; }
.hot-scroll { white-space: nowrap; padding: 10rpx 0; }
.hot-item { display: inline-block; width: 220rpx; margin-right: 20rpx; background: #fff; border-radius: 16rpx; overflow: hidden; box-shadow: 0 2rpx 12rpx rgba(45,52,54,0.05); }
.hot-img { width: 220rpx; height: 200rpx; background: #F7F5F2; }
.hot-title { display: block; padding: 10rpx 14rpx 4rpx; font-size: 24rpx; width: 192rpx; }
.hot-item .price { display: block; padding: 0 14rpx 14rpx; font-size: 28rpx; }
.note-card { background: #fff; border-radius: 16rpx; padding: 24rpx; margin-bottom: 16rpx; display: flex; justify-content: space-between; align-items: center; box-shadow: 0 2rpx 8rpx rgba(45,52,54,0.03); }
.note-info { flex: 1; overflow: hidden; }
.note-title { font-size: 28rpx; font-weight: 500; display: block; margin-bottom: 8rpx; }
.note-stats { display: flex; align-items: center; gap: 12rpx; margin-top: 8rpx; }
.note-price-free { color: #3C8D6E; font-weight: 600; font-size: 28rpx; }
